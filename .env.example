AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com
AMADEUS_MAX_OFFERS=10

DUFFEL_ACCESS_TOKEN=
DUFFEL_BASE_URL=https://api.duffel.com
DUFFEL_VERSION=v2

BOOKING_DEMAND_API_TOKEN=
BOOKING_AFFILIATE_ID=
BOOKING_DEMAND_BASE_URL=https://demandapi-sandbox.booking.com/3.2
BOOKING_BOOKER_COUNTRY=pl

SKYSCANNER_API_KEY=
SKYSCANNER_BASE_URL=https://partners.api.skyscanner.net
SKYSCANNER_MARKET=PL
SKYSCANNER_LOCALE=pl-PL

HOTELBEDS_API_KEY=
HOTELBEDS_SECRET=
HOTELBEDS_BASE_URL=https://api.test.hotelbeds.com

SERPAPI_KEY=

APIFY_API_TOKEN=

# Free self-serve key for real driving distance/duration between ANY two
# places (not just CITY_DATABASE's ~130 airport cities) — sign up at
# https://openrouteservice.org/dev/#/signup. Powers the ground-transport
# provider's car/bus/train estimates. Geocoding free-text place names uses
# OpenStreetMap's Nominatim, which needs no key.
OPENROUTESERVICE_API_KEY=
OPENROUTESERVICE_BASE_URL=https://api.openrouteservice.org
# Optional — Nominatim's usage policy wants a descriptive User-Agent, not a
# generic one; only override if you want your own contact info attached.
NOMINATIM_USER_AGENT=

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-5-mini
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=TripWeaver

# Add provider-specific location ids that are not safe to guess.
# Example:
# TRIPWEAVER_LOCATION_HINTS_JSON={"barcelona":{"bookingCityId":-372490,"skyscannerHotelEntityId":"27548283","hotelbedsDestinationCode":"BCN"}}
TRIPWEAVER_LOCATION_HINTS_JSON=
